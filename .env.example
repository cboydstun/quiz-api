# Postgres. Provisioned by `vercel integration add neon`; pull with
# `vercel env pull .env.local`. Note that drizzle-kit and the migration
# scripts do not read .env.local on their own — they go through dotenv-cli.
DATABASE_URL=

# Signs and verifies the JWTs the client stores in localStorage under "token".
# Carry the previous backend's value over: tokens already issued stay valid.
JWT_SECRET=

# Google OAuth. The redirect URI must be registered in Google Cloud Console
# for every origin that serves the app, including Vercel preview domains.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/login

# Only needed for the one-off `pnpm migrate:mongo` import.
MONGO_URI=

# Optional. The GraphQL endpoint is same-origin, so this is only needed to
# point the client at a different backend. Defaults to /v1/graphql.
# NEXT_PUBLIC_API_URL=

# Optional Google Analytics. Absent means the gtag scripts are not rendered.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# The site's own absolute origin, used for canonical URLs, Open Graph tags and
# the sitemap. Open Graph images have to be absolute or a crawler cannot fetch
# them, which is the difference between a link card and a bare domain.
# Falls back to VERCEL_PROJECT_PRODUCTION_URL, then to localhost.
NEXT_PUBLIC_SITE_URL=

# Optional. Backs the rate limiter on register, login and answer submission.
# Without them the limiter falls back to an in-process counter, which is
# weaker across instances but keeps local development and CI network-free.
# Provision with `vercel integration add upstash`.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
