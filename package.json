{
  "name": "quiz-api",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @quiz/db generate",
    "db:migrate": "pnpm --filter @quiz/db migrate",
    "migrate:mongo": "dotenv -e .env -- tsx scripts/migrate-mongo.ts",
    "seed:questions": "dotenv -e .env.local -- tsx scripts/seed-questions.ts",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@neondatabase/serverless": "^1.1.0",
    "@types/node": "^26.2.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-orm": "^0.45.2",
    "eslint": "^9.39.5",
    "mongodb": "^7.5.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "turbo": "^2.10.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0"
  },
  "pnpm": {
    "overrides": {
      "graphql": "^16.14.2"
    }
  }
}
